# Vaapsi storefront — environment template.
# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the storefront (used for canonical URLs and passport deep links).
NEXT_PUBLIC_SITE_URL=

# Backend API base URL. Owned by IPguide. While empty, lib/data falls back to
# the mock adapter and the app runs entirely on local fixtures.
NEXT_PUBLIC_API_BASE_URL=

# Digital Product Passport provider. Vendor not yet named — see PRD open question #2.
NEXT_PUBLIC_PASSPORT_REGISTRY_URL=

# Analytics (GA4). Optional; analytics is a no-op when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
