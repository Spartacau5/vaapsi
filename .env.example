# Vaapsi storefront — environment template.
# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the storefront. Used for canonical URLs, Open Graph, the
# sitemap, and the QR code printed on a garment — so on a deployed preview this
# must be the deployment URL, not left blank.
NEXT_PUBLIC_SITE_URL=

# Allow search engines to index this deployment. Opt-in: set to exactly 1 only
# on the real production domain. Every preview and client-review link should
# leave this unset, which blocks crawling in robots.txt and in the meta tag.
NEXT_PUBLIC_INDEXABLE=

# Backend API base URL. Owned by IPguide. While empty, lib/data falls back to
# the mock adapter and the app runs entirely on local fixtures.
NEXT_PUBLIC_API_BASE_URL=

# Digital Product Passport provider. Vendor not yet named — see PRD open question #2.
NEXT_PUBLIC_PASSPORT_REGISTRY_URL=

# Analytics (GA4). Optional; analytics is a no-op when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
